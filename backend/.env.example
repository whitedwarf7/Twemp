# Demo mode is deterministic and does not require credentials.
AGENT_PROVIDER=demo

# Required only when AGENT_PROVIDER=openai. Keep this server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_AGENTS_TRACING=false

# Comma-separated list of allowed frontend origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
